-#include "tegra194-camera-jakku-rbpcv2-imx219.dtsi"
+
+#ifdef VC_MIPI
+	#include "tegra194-camera-vc-mipi-cam.dtsi"
+#else
+        #include "tegra194-camera-jakku-rbpcv3-imx477.dtsi"
+        #include "tegra194-camera-jakku-rbpcv2-imx219.dtsi"
+#endif
+
 / {
 	gpio-keys {
 		compatible = "gpio-keys";
