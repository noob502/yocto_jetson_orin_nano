+                ret = vc_core_set_num_lanes(cam, signal->num_lanes);
+                if (ret) 
+                        return ret;
+
+                vc_notice(dev, "%s(): Init lanes (num_lanes: %d)\n", __FUNCTION__, signal->num_lanes);
+                return 0;
+        }
+        return -EINVAL;
+}
