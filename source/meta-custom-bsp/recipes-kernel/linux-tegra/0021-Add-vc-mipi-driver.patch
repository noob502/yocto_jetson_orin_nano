+static int vc_stop_streaming(struct tegracam_device *tc_dev)
+{
+        struct vc_cam *cam = tegracam_to_cam(tc_dev);
+        int ret = 0;
+        
+        ret = vc_sen_stop_stream(cam);
+        usleep_range(1000*g_sleepP, 1000*g_sleepP);
+
+        return ret;
+}
