From aeebaf9adffac81c28e3a4668fd3594b03ec436a Mon Sep 17 00:00:00 2001
From: Ming Liu <liu.ming50@gmail.com>
Date: Sat, 14 Dec 2024 13:16:06 +0100
Subject: [PATCH] flash_l4t_t234_nvme_rootfs_ab.xml: let data partition to be
 the last one

Signed-off-by: Ming Liu <liu.ming50@gmail.com>
---
 .../flash_l4t_t234_nvme_rootfs_ab.xml         | 24 +++++++++----------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/tools/kernel_flash/flash_l4t_t234_nvme_rootfs_ab.xml b/tools/kernel_flash/flash_l4t_t234_nvme_rootfs_ab.xml
index 8a11273..a5f0bff 100644
--- a/tools/kernel_flash/flash_l4t_t234_nvme_rootfs_ab.xml
+++ b/tools/kernel_flash/flash_l4t_t234_nvme_rootfs_ab.xml
@@ -138,18 +138,7 @@
             <percent_reserved> 0 </percent_reserved>
             <description> **Required.** EFI system partition for fail-safe ESP update. </description>
         </partition>
-        <partition name="UDA" type="data">
-            <allocation_policy> sequential </allocation_policy>
-            <filesystem_type> basic </filesystem_type>
-            <size> 419430400 </size>
-            <file_system_attribute> 0 </file_system_attribute>
-            <allocation_attribute> 8 </allocation_attribute>
-            <percent_reserved> 0 </percent_reserved>
-            <align_boundary> 16384 </align_boundary>
-            <description> **Required.** This partition may be mounted and used to store user
-              data. </description>
-        </partition>
-        <partition name="reserved" type="data">
+        <partition name="reserved" id="16" type="data">
             <allocation_policy> sequential </allocation_policy>
             <filesystem_type> basic </filesystem_type>
             <size> 502792192 </size> <!-- Recalculate the size if RECSIZE changed -->
@@ -187,6 +176,17 @@
             <description> **Required.** Contains the rootfs. This partition must be assigned
               the "2" for id as it is physically put to the end of the device, so that it
               can be accessed as the fixed known special device `/dev/nvme0n1p2`. </description>
+	</partition>
+        <partition name="UDA" id="15" type="data">
+            <allocation_policy> sequential </allocation_policy>
+            <filesystem_type> basic </filesystem_type>
+            <size> 419430400 </size>
+            <file_system_attribute> 0 </file_system_attribute>
+            <allocation_attribute> 8 </allocation_attribute>
+            <percent_reserved> 0 </percent_reserved>
+            <align_boundary> 16384 </align_boundary>
+            <description> **Required.** This partition may be mounted and used to store user
+              data. </description>
         </partition>
         <partition name="secondary_gpt" type="secondary_gpt">
             <allocation_policy> sequential </allocation_policy>
-- 
2.43.0

