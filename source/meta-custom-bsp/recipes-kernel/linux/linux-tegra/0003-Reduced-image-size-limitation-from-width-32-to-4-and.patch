From 8b9ec3336aadf11cb136216611f6b243483995b3 Mon Sep 17 00:00:00 2001
From: "/setup.sh" <support@vision-components.com>
Date: Thu, 14 Jul 2022 15:32:14 +0200
Subject: [PATCH 03/19] Reduced image size limitation from width 32 to 4 and
 height from 4 to 1.

---
 nvidia/drivers/media/platform/tegra/camera/vi/channel.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/nvidia/drivers/media/platform/tegra/camera/vi/channel.c b/nvidia/drivers/media/platform/tegra/camera/vi/channel.c
index 6a28be5bedc9..abde02f480b0 100644
--- a/nvidia/drivers/media/platform/tegra/camera/vi/channel.c
+++ b/nvidia/drivers/media/platform/tegra/camera/vi/channel.c
@@ -2168,8 +2168,7 @@ __tegra_channel_set_frame_size(struct tegra_channel *chan,
 	struct sensor_properties *sensor = &s_data->sensor_props;
 	int mode_idx = 0;
 
-	pix->width = (pix->width / 32) * 32;
-	pix->height = (pix->height / 4) * 4;
+	pix->width = (pix->width / 4) * 4;
 
 	s_data->def_width = pix->width;
 	s_data->def_height = pix->height;
-- 
2.43.0

