From 99f6f5f346b2f8d48f70effb46ca8e936d9b9ffb Mon Sep 17 00:00:00 2001
Date: Sun, 16 Nov 2025 11:59:46 +0100
Subject: [PATCH] tegra234.dtsi: enable usb3 super speed

Upstream-Status: Inappropriate [OE specific]

---
 hardware/nvidia/t23x/nv-public/tegra234.dtsi | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/hardware/nvidia/t23x/nv-public/tegra234.dtsi b/hardware/nvidia/t23x/nv-public/tegra234.dtsi
index 91474c5..86cc735 100644
--- a/hardware/nvidia/t23x/nv-public/tegra234.dtsi
+++ b/hardware/nvidia/t23x/nv-public/tegra234.dtsi
@@ -3162,25 +3162,26 @@
 					lanes {
 						usb3-0 {
 							nvidia,function = "xusb";
-							status = "disabled";
+							status = "okay";
 							#phy-cells = <0>;
+							phandle = <0x2ba>;
 						};
 
 						usb3-1 {
 							nvidia,function = "xusb";
-							status = "disabled";
+							status = "okay";
 							#phy-cells = <0>;
 						};
 
 						usb3-2 {
 							nvidia,function = "xusb";
-							status = "disabled";
+							status = "okay";
 							#phy-cells = <0>;
 						};
 
 						usb3-3 {
 							nvidia,function = "xusb";
-							status = "disabled";
+							status = "okay";
 							#phy-cells = <0>;
 						};
 					};
@@ -3209,7 +3210,8 @@
 				};
 
 				usb3-1 {
-					status = "disabled";
+					nvidia,usb2-companion = <0x01>;
+					status = "okay";
 				};
 
 				usb3-2 {
@@ -3217,7 +3219,8 @@
 				};
 
 				usb3-3 {
-					status = "disabled";
+					nvidia,usb2-companion = <0x01>;
+					status = "okay";
 				};
 			};
 		};
